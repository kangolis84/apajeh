let soalAktif = [];
let indeksSekarang = 0;
let jawabanUser = [];

let sisaWaktu = durasiKuisDetik;
let intervalTimer = null;

// Elemen Halaman (Start, Quiz, Result)
const startSection = document.getElementById("start-section");
const quizSection = document.getElementById("quiz-section");
const resultSection = document.getElementById("result-section");

// Elemen Teks & Input
const questionTextEl = document.getElementById("question-text");
const answerInputEl = document.getElementById("answer-input");
const progressTextEl = document.getElementById("progress-text");
const timerBadgeEl = document.getElementById("timer-badge");

// Elemen Tombol
const startBtn = document.getElementById("start-btn");
const prevBtn = document.getElementById("prev-btn");
const nextBtn = document.getElementById("next-btn");
const submitBtn = document.getElementById("submit-btn");
const restartBtn = document.getElementById("restart-btn");

// Format detik menjadi MM:SS
function formatWaktu(detik) {
    const menit = Math.floor(detik / 60);
    const sisaDetik = detik % 60;
    return `${String(menit).padStart(2, '0')}:${String(sisaDetik).padStart(2, '0')}`;
}

// Tampilkan info ringkas di halaman awal sebelum mulai
document.getElementById("info-jumlah-soal").textContent = `${daftarSoal.length} Soal Isian Singkat`;
document.getElementById("info-durasi").textContent = formatWaktu(durasiKuisDetik);

// Tampilkan catatan pengerjaan di atas soal
document.getElementById("instruction-note").innerHTML = catatanPengerjaan;

// Menjalankan hitung mundur
function mulaiTimer() {
    clearInterval(intervalTimer);
    sisaWaktu = durasiKuisDetik;
    timerBadgeEl.textContent = `${formatWaktu(sisaWaktu)}`;
    timerBadgeEl.classList.remove("warning");

    intervalTimer = setInterval(() => {
        sisaWaktu--;
        timerBadgeEl.textContent = `${formatWaktu(sisaWaktu)}`;

        if (sisaWaktu <= 10) {
            timerBadgeEl.classList.add("warning");
        }

        if (sisaWaktu <= 0) {
            clearInterval(intervalTimer);
            alert("Waktu habis! Jawaban Anda otomatis dikirim.");
            prosesKirimSoal(true);
        }
    }, 1000);
}

// Fungsi mengacak array soal (Algoritma Fisher-Yates)
function acakUrutanSoal(arraySoal) {
    const salinan = [...arraySoal];
    for (let i = salinan.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [salinan[i], salinan[j]] = [salinan[j], salinan[i]];
    }
    return salinan;
}

// Fungsi memulai kuis saat tombol "Mulai Soal" ditekan
function mulaiKuis() {
    soalAktif = acakUrutanSoal(daftarSoal);
    indeksSekarang = 0;
    jawabanUser = new Array(soalAktif.length).fill("");
    
    startSection.style.display = "none";
    resultSection.style.display = "none";
    quizSection.style.display = "block";
    
    tampilkanSoal();
    mulaiTimer();
}

// Fungsi merender soal ke layar
function tampilkanSoal() {
    const soal = soalAktif[indeksSekarang];
    questionTextEl.innerHTML = `${indeksSekarang + 1}. ${soal.pertanyaan}`;
    answerInputEl.value = jawabanUser[indeksSekarang];
    progressTextEl.textContent = `Soal ${indeksSekarang + 1} / ${soalAktif.length}`;

    prevBtn.disabled = (indeksSekarang === 0);

    if (indeksSekarang === soalAktif.length - 1) {
        nextBtn.style.display = "none";
        submitBtn.style.display = "block";
    } else {
        nextBtn.style.display = "block";
        submitBtn.style.display = "none";
    }

    answerInputEl.focus();
}

// Logika penilaian dan tampilan hasil (tanpa menampilkan kunci jawaban)
function prosesKirimSoal(otomatisKarenaWaktu = false) {
    jawabanUser[indeksSekarang] = answerInputEl.value;

    if (!otomatisKarenaWaktu) {
        const adaKosong = jawabanUser.some(j => j.trim() === "");
        if (adaKosong) {
            const yakin = confirm("Masih ada soal yang belum diisi. Tetap kirim jawaban?");
            if (!yakin) return;
        }
    }

    clearInterval(intervalTimer);

    let benarCount = 0;
    const reviewContainer = document.getElementById("review-container");
    reviewContainer.innerHTML = "";

    soalAktif.forEach((soal, index) => {
        const jwbAsli = jawabanUser[index].trim();
        const jwbBersih = jwbAsli.toLowerCase();
        const isBenar = soal.kunci.includes(jwbBersih);

        if (isBenar) benarCount++;

        const itemDiv = document.createElement("div");
        itemDiv.className = `review-item ${isBenar ? 'benar' : 'salah'}`;
        
        const tampilanJwbUser = jwbAsli === "" ? "<i>(Tidak dijawab)</i>" : jwbAsli;
        const infoKoreksi = isBenar 
            ? `<span style="color:#27ae60; font-weight:bold;">✓ Benar</span>` 
            : `<span style="color:#c0392b; font-weight:bold;">✗ Salah</span>`;

        itemDiv.innerHTML = `
            <div class="review-q">${index + 1}. ${soal.pertanyaan}</div>
            <div class="review-a">Jawaban Anda: ${tampilanJwbUser} — ${infoKoreksi}</div>
        `;
        reviewContainer.appendChild(itemDiv);
    });

    const skorAkhir = Math.round((benarCount / soalAktif.length) * 100);
    document.getElementById("final-score").textContent = `Skor Akhir: ${skorAkhir}`;
    document.getElementById("score-detail").textContent = `Benar ${benarCount} dari ${soalAktif.length} soal`;

    quizSection.style.display = "none";
    resultSection.style.display = "block";
}

// Fungsi kembali ke tampilan awal (layar tombol Mulai Soal)
function kembaliKeAwal() {
    clearInterval(intervalTimer);
    indeksSekarang = 0;
    jawabanUser = [];

    resultSection.style.display = "none";
    quizSection.style.display = "none";
    startSection.style.display = "block";
}

// Event Tombol Mulai Soal
startBtn.addEventListener("click", mulaiKuis);

// Event Tombol Sebelumnya
prevBtn.addEventListener("click", function() {
    jawabanUser[indeksSekarang] = answerInputEl.value;
    if (indeksSekarang > 0) {
        indeksSekarang--;
        tampilkanSoal();
    }
});

// Event Tombol Selanjutnya
nextBtn.addEventListener("click", function() {
    jawabanUser[indeksSekarang] = answerInputEl.value;
    if (indeksSekarang < soalAktif.length - 1) {
        indeksSekarang++;
        tampilkanSoal();
    }
});

// Event Tombol Kirim Soal
submitBtn.addEventListener("click", function() {
    prosesKirimSoal(false);
});

// Event Tombol Ulangi Kuis -> Kembali ke layar awal
restartBtn.addEventListener("click", kembaliKeAwal);

// Dukungan tombol Enter pada keyboard
answerInputEl.addEventListener("keypress", function(event) {
    if (event.key === "Enter") {
        event.preventDefault();
        if (indeksSekarang < soalAktif.length - 1) {
            nextBtn.click();
        } else {
            submitBtn.click();
        }
    }
});
